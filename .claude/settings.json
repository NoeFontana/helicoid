{
  "permissions": {
    "allow": [
      "Bash(cargo nextest run *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo fmt --check *)",
      "Bash(cargo deny check *)",
      "Bash(cargo tree *)",
      "Bash(just --list)",
      "Bash(just build)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just doc)",
      "Bash(just msrv)",
      "Bash(just no-std)",
      "Bash(just wasm)",
      "Bash(just audit)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(just corpus-check)",
      "Bash(just thresholds-check)",
      "Bash(just determinism)",
      "Bash(just envelope --check)"
    ],
    "deny": [
      "Read(./conformance/corpus/**)",
      "Read(./conformance/corpus-deep/**)",
      "Read(./conformance/results*/**)",
      "Read(./docs/book/**)",
      "Read(./docs/changelog/**)",
      "Read(./baseline/bench/**)",
      "Read(./target*/**)",
      "Read(./runners/*/target/**)",
      "Edit(./crates/helicoid/src/coeffs/generated*.rs)",
      "Edit(./conformance/corpus/**)",
      "Edit(./conformance/sweeps/**)",
      "Edit(./docs/changelog/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.rs) rustfmt --edition 2021 \"$f\" >/dev/null 2>&1;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
